{
  "name": "git-note-history",
  "version": "0.11.2",
  "private": true,
  "license": "MIT",
  "description": "Git-backed note history viewer for Obsidian",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "styles": "node scripts/build-styles.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "node scripts/build-styles.mjs && vitest run",
    "lint": "eslint src && stylelint \"styles/*.css\" styles.css",
    "check": "npm run build && npm run lint && npm test",
    "package:release": "npm run build && node scripts/package-release.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "release:check": "npm run check && node scripts/package-release.mjs && npm run verify:release",
    "install:local": "node scripts/install-local.mjs",
    "release:local": "npm run release:check && npm run install:local"
  },
  "dependencies": {
    "diff": "^8.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/json": "^0.14.0",
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.5",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.2",
    "obsidian": "^1.8.7",
    "stylelint": "^17.16.0",
    "stylelint-no-unsupported-browser-features": "^8.1.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^3.2.4"
  }
}
