{
  "name": "git-note-history",
  "version": "0.5.0",
  "private": true,
  "description": "Git-backed note history viewer for Obsidian",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit && node esbuild.config.mjs production",
    "test": "vitest run",
    "check": "npm run build && npm test",
    "package:release": "npm run build && node scripts/package-release.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "release:check": "npm run check && node scripts/package-release.mjs && npm run verify:release",
    "install:local": "node scripts/install-local.mjs",
    "release:local": "npm run release:check && npm run install:local"
  },
  "dependencies": {
    "diff": "^8.0.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "esbuild": "^0.25.5",
    "obsidian": "^1.8.7",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
